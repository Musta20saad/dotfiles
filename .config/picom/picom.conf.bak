backend = "glx";
vsync = true;
corner-radius = 12;
rounded-corners-exclude = ["window_type = 'dock'", "window_type = 'desktop'"];
fading = true;
fade-in-step = 0.06;
fade-out-step = 0.06;
shadow = false;
shadow-radius = 16;
shadow-opacity = 0.4;
shadow-offset-x = -12;
shadow-offset-y = -12;
shadow-exclude = ["class_g = 'Polybar'", "window_type = 'dock'"];
inactive-opacity = 0.94;
unredir-if-possible = true;
