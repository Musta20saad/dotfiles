#!/usr/bin/env bash
# On-screen display for volume / brightness keys.
#   osd.sh volume up|down|mute      osd.sh brightness up|down
STEP=5
TAG=(-h string:x-dunst-stack-tag:osd)

vol()   { pactl get-sink-volume @DEFAULT_SINK@ | grep -oP '\d+(?=%)' | head -1; }
muted() { pactl get-sink-mute @DEFAULT_SINK@ | awk '{print $2}'; }

show() { # title percent text
  notify-send -u low -t 1500 "${TAG[@]}" -h "int:value:$2" "$1" "$3"
}

case "$1" in
  volume)
    case "$2" in
      up)
        v=$(vol)
        if [ "$v" -ge 100 ]; then n=$v; else n=$((v + STEP)); [ "$n" -gt 100 ] && n=100; fi
        pactl set-sink-mute @DEFAULT_SINK@ 0
        pactl set-sink-volume @DEFAULT_SINK@ "${n}%" ;;
      down)
        pactl set-sink-volume @DEFAULT_SINK@ "-${STEP}%" ;;
      mute)
        pactl set-sink-mute @DEFAULT_SINK@ toggle ;;
    esac
    v=$(vol)
    if [ "$(muted)" = yes ]; then show "Volume" 0 "Muted"; else show "Volume" "$v" "${v}%"; fi ;;
  brightness)
    case "$2" in
      up)   brightnessctl set "${STEP}%+" >/dev/null ;;
      down) brightnessctl -n set "${STEP}%-" >/dev/null ;;
    esac
    p=$(brightnessctl -m | cut -d, -f4 | tr -d %)
    show "Brightness" "$p" "${p}%"
    polybar-msg action "#brightness.hook.0" >/dev/null 2>&1 ;;
esac
