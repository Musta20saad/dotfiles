#!/usr/bin/env bash
THEME='window {width: 380px; location: northeast; anchor: northeast; x-offset: -12px; y-offset: 48px; background-color: #0F1A2B; border: 1px; border-color: #7DD3FC; border-radius: 14px;} mainbox {background-color: transparent;} inputbar {background-color: #162338; text-color: #E6F1FF; padding: 8px; border-radius: 10px; margin: 0 0 6px 0;} prompt {text-color: #7DD3FC;} entry {text-color: #E6F1FF;} listview {lines: 8; background-color: transparent;} element {padding: 6px 10px; border-radius: 8px; background-color: transparent; text-color: #E6F1FF;} element selected {background-color: #267DD3FC; text-color: #7DD3FC;}'
parse() { sed -n 's/^Device \([0-9A-F:]*\) \(.*\)/\1|\2/p'; }

if ! bluetoothctl show 2>/dev/null | grep -q 'Powered: yes'; then
  c=$(printf "Turn Bluetooth on" | rofi -dmenu -i -p "Bluetooth" -theme-str "$THEME")
  [ -n "$c" ] && { rfkill unblock bluetooth; sleep 0.5; bluetoothctl power on; }
  exit
fi

mapfile -t devs < <(bluetoothctl devices Paired | parse)
display=(); macs=()
for d in "${devs[@]}"; do
  mac=${d%%|*}; name=${d#*|}; mark="   "
  bluetoothctl info "$mac" | grep -q 'Connected: yes' && mark="●  "
  display+=("${mark}${name}"); macs+=("$mac")
done
n=${#macs[@]}
opts=("${display[@]}" "Scan for new devices" "Turn Bluetooth off" "Advanced settings")
idx=$(printf '%s\n' "${opts[@]}" | rofi -dmenu -i -p "Bluetooth" -format i -theme-str "$THEME")
[ -z "$idx" ] && exit

if [ "$idx" -eq "$n" ]; then
  notify-send "Bluetooth" "Scanning for 8 seconds..."
  bluetoothctl --timeout 8 scan on >/dev/null 2>&1
  declare -A paired; for d in "${devs[@]}"; do paired[${d%%|*}]=1; done
  fd=(); fm=()
  while IFS= read -r d; do
    mac=${d%%|*}; name=${d#*|}
    [ -n "${paired[$mac]}" ] && continue
    [ "$name" = "${mac//:/-}" ] && continue
    fd+=("$name"); fm+=("$mac")
  done < <(bluetoothctl devices | parse)
  [ ${#fm[@]} -eq 0 ] && { notify-send "Bluetooth" "No new devices found"; exit; }
  j=$(printf '%s\n' "${fd[@]}" | rofi -dmenu -i -p "Pair" -format i -theme-str "$THEME")
  [ -z "$j" ] && exit
  mac=${fm[$j]}
  notify-send "Bluetooth" "Pairing with ${fd[$j]}..."
  if bluetoothctl pair "$mac" && bluetoothctl trust "$mac" && bluetoothctl connect "$mac"; then
    notify-send "Bluetooth" "Connected to ${fd[$j]}"
  else
    notify-send "Bluetooth" "Pairing failed"
  fi
elif [ "$idx" -eq $((n+1)) ]; then
  bluetoothctl power off
elif [ "$idx" -eq $((n+2)) ]; then
  blueman-manager
else
  mac=${macs[$idx]}; name=${display[$idx]:3}
  if bluetoothctl info "$mac" | grep -q 'Connected: yes'; then
    bluetoothctl disconnect "$mac" >/dev/null && notify-send "Bluetooth" "Disconnected from $name"
  else
    notify-send "Bluetooth" "Connecting to $name..."
    if timeout 15 bluetoothctl connect "$mac" >/dev/null; then
      notify-send "Bluetooth" "Connected to $name"
    else
      notify-send "Bluetooth" "Couldn't connect to $name"
    fi
  fi
fi
