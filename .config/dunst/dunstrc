[global]
    monitor = 0
    follow = none
    width = 320
    height = 140
    origin = bottom-center
    offset = 0x70
    notification_limit = 4
    gap_size = 8
    padding = 16
    horizontal_padding = 22
    corner_radius = 16
    frame_width = 1
    frame_color = "#7DD3FC80"
    separator_height = 0
    transparency = 0

    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_corner_radius = 5
    progress_bar_min_width = 200
    progress_bar_max_width = 400
    highlight = "#7DD3FC"

    font = DejaVu Sans Mono 11
    alignment = center
    markup = full
    format = "<b>%s</b>\n%b"
    icon_position = off
    sort = no
    stack_duplicates = true
    hide_duplicate_count = true
    show_age_threshold = -1
    history_length = 20
    mouse_left_click = close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#0F1A2BF2"
    foreground = "#E6F1FF"
    timeout = 2

[urgency_normal]
    background = "#0F1A2BF2"
    foreground = "#E6F1FF"
    timeout = 5

[urgency_critical]
    background = "#0F1A2BF2"
    foreground = "#E6F1FF"
    frame_color = "#F87171"
    highlight = "#F87171"
    timeout = 0
